# Home Assistant process/API/recorder watchdog. Tokens never enter argv or logs.
HASS_WATCH_TOKEN=""
# Pick a recorder-included sensor that changes overnight as well as during the day.
# Stale/unavailable sensors raise probe_error, never trigger a restart.
HASS_WATCH_ENTITY="sensor.shm2_em_metering_frequency"
#HASS_WATCH_URL="http://localhost:8123"
#HASS_WATCH_INTERVAL="60"
#HASS_WATCH_THRESHOLD="3"
#HASS_WATCH_GRACE="300"
#HASS_WATCH_HISTORY_WINDOW="600"
#HASS_WATCH_RESTART_BACKOFF="300"
#HASS_WATCH_RESTART_WINDOW="3600"
#HASS_WATCH_MAX_RESTARTS="3"
#HASS_WATCH_SERVICE="home-assistant-container"
# rc-service home-assistant-container stop disarms recovery until the next start.
# For temporary work with HA still running: touch /run/home-assistant-maintenance
# Resume checks: rm /run/home-assistant-maintenance
# Attempt budget persists across watchdog restarts, resets on host reboot.
# Evidence: last three bounded root-only JSON files in /var/log/home-assistant-recovery.
