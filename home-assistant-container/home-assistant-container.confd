# Home Assistant Container Configuration

# Container image (default: version matching this package)
CONTAINER_IMAGE="ghcr.io/home-assistant/home-assistant:@VERSION@"

# Use latest stable instead of pinned version:
#CONTAINER_IMAGE="ghcr.io/home-assistant/home-assistant:stable"

# Extra podman options (e.g., resource limits, additional mounts)
#CONTAINER_EXTRA_OPTS="--memory=2g --cpus=2"

# Optional host-specific pre-start gate. A timeout leaves recovery armed.
#CONTAINER_READY_COMMAND="/usr/local/sbin/homehub-ha-ready"
#CONTAINER_READY_TIMEOUT="120"
