# vector service configuration (OpenRC).
#
# Runtime settings and secrets do NOT go here — supervise-daemon's privilege
# drop strips exported env from the daemon. Put them in /etc/vector/vector.env
# (root-only, 0600); the run wrapper sources that after the drop. Example:
#   VECTOR_CONFIG=/etc/vector/vector.yaml
#   VECTOR_LOGS_URL=...
#   VECTOR_LOGS_USERNAME=...
#   VECTOR_LOGS_PASSWORD=...

# user:group to run the process with (unprivileged; the wrapper handles env)
command_user="vector:vector"

# extra arguments appended after `--config <VECTOR_CONFIG>`
command_args=""

# where to store logs for vector process output
#logfile="/var/log/vector.log"

# comment to use traditional service management
supervisor=supervise-daemon
