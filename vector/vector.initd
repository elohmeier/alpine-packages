#!/sbin/openrc-run

: ${command_user:="vector:vector"}
: ${logfile:="/var/log/$RC_SVCNAME.log"}
: ${vector_config:="/etc/vector/vector.yaml"}

name=vector
description="Vector high-performance observability data pipeline"
# Run through the wrapper so the runtime env (secrets, VECTOR_CONFIG) survives
# the privilege drop and the daemon always loads the yaml config, not Vector's
# /etc/vector/vector.toml default. See /usr/libexec/vector/vector-run.
command="/usr/libexec/vector/vector-run"
command_background="yes"
pidfile="/run/$RC_SVCNAME.pid"
capabilities="^cap_net_bind_service"

extra_started_commands="reload"
description_reload="Reload vector daemon"

output_log="$logfile"
error_log="$logfile"

depend() {
	need net
	after firewall
}

# Validate the actual config (with the runtime env sourced), not the .toml
# default that a yaml install does not ship.
_validate() {
	(
		set -a
		[ -r /etc/vector/vector.env ] && . /etc/vector/vector.env
		set +a
		/usr/bin/vector validate "${VECTOR_CONFIG:-$vector_config}"
	)
}

start_pre() {
	checkpath -d -o "$command_user" /var/lib/vector
	_validate
}

reload() {
	ebegin "Reloading $RC_SVCNAME"
	_validate
	if [ -n "$supervisor" ]; then
		$supervisor "$RC_SVCNAME" --signal HUP
	else
		start-stop-daemon --signal HUP --pidfile "$pidfile"
	fi
	eend $?
}
