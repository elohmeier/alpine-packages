# Configuration for uStreamer

# V4L2 capture device
#USTREAMER_DEVICE="/dev/video0"

# Seconds to wait for a frame before reopening the device
#USTREAMER_DEVICE_TIMEOUT="1"

# Capture resolution, format and rate (device defaults are used when unset)
#USTREAMER_RESOLUTION="1280x720"
#USTREAMER_FORMAT="MJPEG"
#USTREAMER_DESIRED_FPS="30"

# JPEG quality 1-100, ignored when the device streams MJPEG natively
#USTREAMER_QUALITY="80"

# HTTP listener. Keep the loopback default unless the stream should be
# reachable from the LAN; there is no authentication unless --user/--passwd
# are added via USTREAMER_OPTS.
#USTREAMER_HOST="127.0.0.1"
#USTREAMER_PORT="8080"

# Slow down the capture to 1 FPS while no HTTP client is connected
#USTREAMER_SLOWDOWN="yes"

# Additional options to pass to ustreamer
# See 'ustreamer --help' for the full list
# Example: USTREAMER_OPTS="--drop-same-frames=30 --allow-origin=*"
#USTREAMER_OPTS=""

# User and group to run uStreamer as. The group must have access to the
# capture device (video on Alpine).
#USTREAMER_USER="ustreamer"
#USTREAMER_GROUP="video"
