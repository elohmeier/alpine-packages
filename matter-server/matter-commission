#!/usr/bin/env python3
"""CLI tool to commission Matter devices via the matter-server."""

import argparse
import asyncio
import getpass
import sys

import aiohttp
from matter_server.client.client import MatterClient
from matter_server.client.exceptions import MatterClientException
from matter_server.common.errors import MatterError


async def wait_until_ready(
    init_ready: asyncio.Event,
    listener: asyncio.Task[None],
    timeout: int = 10,
) -> None:
    """Wait for initial node data while surfacing listener failures promptly."""
    ready_waiter = asyncio.create_task(init_ready.wait())
    try:
        done, _ = await asyncio.wait(
            (ready_waiter, listener),
            timeout=timeout,
            return_when=asyncio.FIRST_COMPLETED,
        )
        if ready_waiter in done:
            return
        if listener in done:
            await listener
            raise ConnectionError("Matter server listener stopped during startup")
        raise asyncio.TimeoutError
    finally:
        if not ready_waiter.done():
            ready_waiter.cancel()
        await asyncio.gather(ready_waiter, return_exceptions=True)


async def run(
    code: str | None,
    host: str = "localhost",
    port: int = 5580,
    check: bool = False,
) -> int:
    """Check the server or commission a device through the Matter client."""
    url = f"ws://{host}:{port}/ws"

    try:
        async with aiohttp.ClientSession() as session:
            client = MatterClient(url, session)
            init_ready = asyncio.Event()
            listener = asyncio.create_task(client.start_listening(init_ready))

            try:
                await wait_until_ready(init_ready, listener)

                if check:
                    info = client.server_info
                    print(f"Matter server reachable at {url}")
                    print(f"  Nodes loaded:           {len(client.get_nodes())}")
                    print(
                        "  Bluetooth enabled:      "
                        f"{'yes' if info.bluetooth_enabled else 'no'}"
                    )
                    print(
                        "  Thread credentials set: "
                        f"{'yes' if info.thread_credentials_set else 'no'}"
                    )
                    return 0

                if code is None:
                    raise ValueError("A setup code is required for commissioning")

                if not client.server_info.thread_credentials_set:
                    print(
                        "Warning: Thread credentials are not set in matter-server",
                        file=sys.stderr,
                    )

                print("Commissioning device...")
                node = await asyncio.wait_for(
                    client.commission_with_code(code.strip()), timeout=180
                )
                vendor = node.attributes.get("0/40/1", "Unknown")
                product = node.attributes.get("0/40/3", "Unknown")

                print(f"Success! Node ID: {node.node_id}")
                print(f"  Vendor:  {vendor}")
                print(f"  Product: {product}")
                return 0
            finally:
                await client.disconnect()
                if not listener.done():
                    listener.cancel()
                await asyncio.gather(listener, return_exceptions=True)

    except asyncio.TimeoutError:
        print("Error: Timeout communicating with matter-server", file=sys.stderr)
        return 1
    except (
        aiohttp.ClientError,
        MatterClientException,
        MatterError,
        OSError,
        ValueError,
    ) as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1


def main():
    parser = argparse.ArgumentParser(
        description="Commission a Matter device through matter-server",
        epilog=(
            "Omit CODE to enter it using a no-echo prompt. "
            "Example: matter-commission"
        ),
    )
    parser.add_argument(
        "code",
        nargs="?",
        help="Matter QR payload or manual setup code (omit for a secure prompt)",
    )
    parser.add_argument("--host", default="localhost", help="Matter server host")
    parser.add_argument("--port", type=int, default=5580, help="Matter server port")
    parser.add_argument(
        "--check",
        action="store_true",
        help="Check connectivity and load nodes without commissioning",
    )

    args = parser.parse_args()
    if args.check and args.code:
        parser.error("CODE cannot be used with --check")

    code = args.code
    if not args.check and code is None:
        code = getpass.getpass("Matter setup code: ")
        if not code.strip():
            parser.error("a non-empty setup code is required")

    try:
        result = asyncio.run(run(code, args.host, args.port, args.check))
    except KeyboardInterrupt:
        print("\nCommissioning cancelled", file=sys.stderr)
        result = 130
    sys.exit(result)


if __name__ == "__main__":
    main()
