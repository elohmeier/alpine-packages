#!/bin/sh

set -u

program=${0##*/}
config_file=${CERTIFICATE_SYNC_CONFIG:-/etc/conf.d/certificate-sync}
# shellcheck disable=SC1090
[ -f "$config_file" ] && . "$config_file"

: "${TARGET_CONFIG_DIR:=/etc/certificate-sync.d}"
: "${ADAPTER_DIR:=/usr/libexec/certificate-sync}"
: "${STATE_BASE_DIR:=/var/lib/certificate-sync}"
: "${LOCK_BASE_DIR:=/run/certificate-sync}"

usage() {
    cat <<'EOF'
Usage: certificate-sync [--all|--target NAME]
       certificate-sync --check-config [NAME]
       certificate-sync --metrics
       certificate-sync --trust-current-certificate NAME

Fetch narrowly authorized cert-manager TLS Secrets and deliver changed
certificates through per-appliance adapters. Each target has an independent
configuration, state directory, lock, certificate, and rollback boundary.

Options:
  --all                              Synchronize every configured target.
  --target NAME                      Synchronize one target.
  --check-config [NAME]              Validate all or one target configuration.
  --metrics                          Emit non-secret Influx line protocol.
  --trust-current-certificate NAME   One-time OPNsense bootstrap after an
                                     independently verified TLS failure.
EOF
}

valid_target_name() {
    case "$1" in
        ''|*[!A-Za-z0-9_-]*) return 1 ;;
        *) return 0 ;;
    esac
}

target_file() {
    valid_target_name "$1" || return 1
    printf '%s/%s.conf\n' "$TARGET_CONFIG_DIR" "$1"
}

target_names() {
    for file in "$TARGET_CONFIG_DIR"/*.conf; do
        [ -f "$file" ] || continue
        name=${file##*/}
        name=${name%.conf}
        valid_target_name "$name" || continue
        printf '%s\n' "$name"
    done
    return 0
}

metric_value() {
    metric=$(sed -n "s/^$1=//p" "$2" 2>/dev/null | head -n1)
    case "$metric" in
        ''|*[!0-9]*) printf '0' ;;
        *) printf '%s' "$metric" ;;
    esac
}

escape_tag() {
    printf '%s' "$1" | sed 's/\\/\\\\/g;s/,/\\,/g;s/ /\\ /g;s/=/\\=/g'
}

emit_target_metrics() (
    target=$1
    file=$(target_file "$target") || exit 0
    [ -r "$file" ] || exit 0
    # shellcheck disable=SC1090
    . "$file"
    hostname=${CERTIFICATE_HOSTNAME:-unknown}
    state_file=$STATE_BASE_DIR/$target/state
    tags="target=$(escape_tag "$target"),hostname=$(escape_tag "$hostname")"
    if [ ! -r "$state_file" ]; then
        printf 'certificate_sync,%s configured=1i,success=0i,last_attempt=0i,last_success=0i,not_after=0i\n' "$tags"
        exit 0
    fi
    printf 'certificate_sync,%s configured=1i,success=%si,last_attempt=%si,last_success=%si,not_after=%si\n' \
        "$tags" "$(metric_value success "$state_file")" \
        "$(metric_value last_attempt "$state_file")" \
        "$(metric_value last_success "$state_file")" \
        "$(metric_value not_after "$state_file")"
)

emit_metrics() {
    count=0
    for target in $(target_names); do
        emit_target_metrics "$target"
        count=$((count + 1))
    done
    if [ "$count" -eq 0 ]; then
        printf 'certificate_sync configured=0i,success=0i,last_attempt=0i,last_success=0i,not_after=0i\n'
    fi
}

sync_target() (
    target=$1
    action=$2
    trust_current=${3:-0}
    file=$(target_file "$target") || {
        printf '%s: invalid target name: %s\n' "$program" "$target" >&2
        exit 2
    }
    [ -r "$file" ] || {
        printf '%s: target configuration is missing: %s\n' "$program" "$file" >&2
        exit 1
    }

    # shellcheck disable=SC1090
    . "$file"
    : "${ADAPTER:=}"
    : "${KUBE_API_SERVER:=}"
    : "${KUBE_NAMESPACE:=}"
    : "${KUBE_SECRET_NAME:=}"
    : "${KUBE_CA_FILE:=/etc/certificate-sync/kube-ca.crt}"
    : "${KUBE_TOKEN_FILE:=/etc/certificate-sync/kube-token}"
    : "${CERTIFICATE_HOSTNAME:=}"
    : "${CONNECT_IP:=}"
    : "${CONNECT_PORT:=443}"
    : "${CERTIFICATE_URL_PATH:=/}"
    : "${MINIMUM_VALID_DAYS:=21}"
    : "${VERIFY_ATTEMPTS:=12}"
    : "${VERIFY_INTERVAL_SECONDS:=5}"

    state_dir=$STATE_BASE_DIR/$target
    state_file=$state_dir/state
    lock_dir=$LOCK_BASE_DIR-$target.lock
    adapter_file=$ADAPTER_DIR/$ADAPTER.sh
    tmp_dir=
    lock_owned=0
    state_loaded=0
    state_success=0
    state_last_attempt=0
    state_last_success=0
    state_not_after=0
    state_fingerprint=
    state_spki_pin=
    state_resource_version=

    log() {
        message="target=$target $*"
        logger -t "$program" -- "$message" 2>/dev/null || true
        printf '%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$message"
    }

    state_value() {
        [ -f "$state_file" ] || return 0
        sed -n "s/^$1=//p" "$state_file" | head -n1
    }

    load_state() {
        [ "$state_loaded" -eq 0 ] || return 0
        state_loaded=1
        [ -f "$state_file" ] || return 0
        state_success=$(state_value success)
        state_last_attempt=$(state_value last_attempt)
        state_last_success=$(state_value last_success)
        state_not_after=$(state_value not_after)
        state_fingerprint=$(state_value fingerprint)
        state_spki_pin=$(state_value spki_pin)
        state_resource_version=$(state_value resource_version)
        : "${state_success:=0}"
        : "${state_last_attempt:=0}"
        : "${state_last_success:=0}"
        : "${state_not_after:=0}"
    }

    write_state() {
        new_success=$1
        new_last_success=$2
        new_not_after=$3
        new_fingerprint=$4
        new_spki_pin=$5
        new_resource_version=$6
        now=$(date -u '+%s')
        mkdir -p "$state_dir"
        chmod 755 "$state_dir"
        state_tmp=$state_dir/.state.$$
        umask 077
        {
            printf 'success=%s\n' "$new_success"
            printf 'last_attempt=%s\n' "$now"
            printf 'last_success=%s\n' "$new_last_success"
            printf 'not_after=%s\n' "$new_not_after"
            printf 'fingerprint=%s\n' "$new_fingerprint"
            printf 'spki_pin=%s\n' "$new_spki_pin"
            printf 'resource_version=%s\n' "$new_resource_version"
        } >"$state_tmp"
        mv -f "$state_tmp" "$state_file"
        chmod 644 "$state_file"
    }

    record_failure() {
        load_state
        write_state 0 "$state_last_success" "$state_not_after" \
            "$state_fingerprint" "$state_spki_pin" "$state_resource_version"
    }

    die() {
        log "ERROR: $*"
        record_failure
        exit 1
    }

    # Invoked indirectly by trap.
    # shellcheck disable=SC2329
    cleanup() {
        [ -z "$tmp_dir" ] || rm -rf -- "$tmp_dir"
        if [ "$lock_owned" -eq 1 ]; then
            rmdir "$lock_dir" 2>/dev/null || true
        fi
    }
    trap cleanup EXIT
    trap 'exit 1' HUP INT TERM

    require_file() {
        [ -s "$1" ] || die "required file is missing or empty: $1"
    }

    certificate_fingerprint() {
        openssl x509 -in "$1" -noout -fingerprint -sha256 2>/dev/null \
            | sed 's/^[^=]*=//;s/://g' | tr '[:lower:]' '[:upper:]'
    }

    certificate_spki_pin() {
        openssl x509 -in "$1" -pubkey -noout 2>/dev/null \
            | openssl pkey -pubin -outform DER 2>/dev/null \
            | openssl dgst -sha256 -binary 2>/dev/null \
            | base64 | tr -d '\r\n'
    }

    # Invoked by sourced adapters.
    # shellcheck disable=SC2329
    fetch_tls_certificate() {
        output=$1
        raw=$tmp_dir/served.raw
        : >"$raw"
        timeout 15 openssl s_client -connect "$CONNECT_IP:$CONNECT_PORT" \
            -servername "$CERTIFICATE_HOSTNAME" -showcerts \
            </dev/null >"$raw" 2>/dev/null || true
        awk '
            /-----BEGIN CERTIFICATE-----/ { capture=1 }
            capture { print }
            /-----END CERTIFICATE-----/ { exit }
        ' "$raw" >"$output"
        openssl x509 -in "$output" -noout >/dev/null 2>&1
    }

    strict_probe() {
        base_url=https://$CERTIFICATE_HOSTNAME
        [ "$CONNECT_PORT" = 443 ] || base_url=$base_url:$CONNECT_PORT
        curl --silent --show-error --fail --output /dev/null \
            --connect-timeout 5 --max-time 15 \
            --resolve "$CERTIFICATE_HOSTNAME:$CONNECT_PORT:$CONNECT_IP" \
            "$base_url$CERTIFICATE_URL_PATH"
    }

    case "$ADAPTER" in
        ''|*[!A-Za-z0-9_-]*) die "ADAPTER is missing or invalid" ;;
    esac
    [ -r "$adapter_file" ] || die "adapter is missing: $adapter_file"
    # shellcheck disable=SC1090
    . "$adapter_file"

    [ -n "$KUBE_NAMESPACE" ] || die "KUBE_NAMESPACE must be configured"
    [ -n "$KUBE_SECRET_NAME" ] || die "KUBE_SECRET_NAME must be configured"
    [ -n "$CERTIFICATE_HOSTNAME" ] || die "CERTIFICATE_HOSTNAME must be configured"
    [ -n "$CONNECT_IP" ] || die "CONNECT_IP must be configured"
    case "$KUBE_API_SERVER" in https://*) ;; *) die "KUBE_API_SERVER must be an https URL" ;; esac
    case "$CONNECT_PORT" in ''|*[!0-9]*) die "CONNECT_PORT must be a TCP port number" ;; esac
    case "$CERTIFICATE_URL_PATH" in /*) ;; *) die "CERTIFICATE_URL_PATH must start with /" ;; esac
    case "$MINIMUM_VALID_DAYS" in
        ''|*[!0-9]*|0) die "MINIMUM_VALID_DAYS must be a positive integer" ;;
    esac
    case "$VERIFY_ATTEMPTS:$VERIFY_INTERVAL_SECONDS" in
        *[!0-9:]*) die "verification timing values must be integers" ;;
    esac
    require_file "$KUBE_CA_FILE"
    require_file "$KUBE_TOKEN_FILE"
    adapter_validate_config

    if [ "$action" = check ]; then
        log "configuration is complete adapter=$ADAPTER"
        exit 0
    fi

    if ! mkdir "$lock_dir" 2>/dev/null; then
        log "another sync is already running"
        exit 0
    fi
    lock_owned=1
    umask 077
    tmp_dir=$(mktemp -d /tmp/certificate-sync.XXXXXX) \
        || die "cannot create temporary directory"

    kube_curl_config=$tmp_dir/kube.curl
    kube_json=$tmp_dir/kube-secret.json
    desired_cert=$tmp_dir/desired.crt
    desired_key=$tmp_dir/desired.key
    served_cert=$tmp_dir/served.crt

    kube_token=$(tr -d '\r\n' <"$KUBE_TOKEN_FILE")
    [ -n "$kube_token" ] || die "Kubernetes token is empty"
    printf 'header = "Authorization: Bearer %s"\n' "$kube_token" >"$kube_curl_config"
    unset kube_token

    if ! curl --silent --show-error --fail \
        --connect-timeout 10 --max-time 30 \
        --cacert "$KUBE_CA_FILE" --config "$kube_curl_config" \
        --output "$kube_json" \
        "$KUBE_API_SERVER/api/v1/namespaces/$KUBE_NAMESPACE/secrets/$KUBE_SECRET_NAME"; then
        die "cannot fetch Kubernetes Secret $KUBE_NAMESPACE/$KUBE_SECRET_NAME"
    fi
    if ! jq -e '
        .type == "kubernetes.io/tls"
        and (.data["tls.crt"] | length) > 0
        and (.data["tls.key"] | length) > 0
    ' "$kube_json" >/dev/null; then
        die "Kubernetes Secret is not a populated TLS Secret"
    fi
    jq -r '.data["tls.crt"]' "$kube_json" | base64 -d >"$desired_cert" \
        || die "cannot decode tls.crt"
    jq -r '.data["tls.key"]' "$kube_json" | base64 -d >"$desired_key" \
        || die "cannot decode tls.key"
    resource_version=$(jq -r '.metadata.resourceVersion // empty' "$kube_json")
    [ -n "$resource_version" ] || die "Kubernetes Secret has no resourceVersion"

    openssl x509 -in "$desired_cert" -noout -checkhost "$CERTIFICATE_HOSTNAME" \
        >/dev/null 2>&1 || die "desired certificate does not match $CERTIFICATE_HOSTNAME"
    desired_cert_public=$tmp_dir/desired-cert-public.der
    desired_key_public=$tmp_dir/desired-key-public.der
    openssl x509 -in "$desired_cert" -pubkey -noout 2>/dev/null \
        | openssl pkey -pubin -outform DER >"$desired_cert_public" 2>/dev/null \
        || die "cannot read desired certificate public key"
    openssl pkey -in "$desired_key" -pubout -outform DER \
        >"$desired_key_public" 2>/dev/null \
        || die "cannot read desired private key"
    cmp -s "$desired_cert_public" "$desired_key_public" \
        || die "desired certificate and private key do not match"
    desired_fingerprint=$(certificate_fingerprint "$desired_cert")
    desired_spki_pin=$(certificate_spki_pin "$desired_cert")
    [ -n "$desired_fingerprint" ] && [ -n "$desired_spki_pin" ] \
        || die "cannot derive desired certificate identity"
    not_after_text=$(openssl x509 -in "$desired_cert" -noout \
        -enddate -dateopt iso_8601 | sed 's/^[^=]*=//')
    not_after_epoch=$(date -u -d "${not_after_text%Z}" '+%s' 2>/dev/null) \
        || die "cannot parse desired certificate expiry"

    adapter_prepare
    adapter_fetch_served "$served_cert" || die "$ADAPTER target did not present a certificate"
    served_fingerprint=$(certificate_fingerprint "$served_cert")
    served_spki_pin=$(certificate_spki_pin "$served_cert")
    [ -n "$served_fingerprint" ] && [ -n "$served_spki_pin" ] \
        || die "cannot derive the served certificate identity"

    strict_ok=0
    strict_probe >/dev/null 2>&1 && strict_ok=1
    adapter_initialize_trust "$strict_ok" "$served_spki_pin"

    if [ "$served_fingerprint" = "$desired_fingerprint" ]; then
        [ "$strict_ok" -eq 1 ] \
            || die "served certificate matches the Secret but strict TLS validation fails"
        now=$(date -u '+%s')
        write_state 1 "$now" "$not_after_epoch" "$desired_fingerprint" \
            "$desired_spki_pin" "$resource_version"
        log "certificate already current; fingerprint=$desired_fingerprint"
        exit 0
    fi

    minimum_valid_seconds=$((MINIMUM_VALID_DAYS * 86400))
    openssl x509 -in "$desired_cert" -noout -checkend "$minimum_valid_seconds" \
        >/dev/null 2>&1 \
        || die "changed certificate expires in less than $MINIMUM_VALID_DAYS days"

    if ! adapter_install "$desired_cert" "$desired_key" "$desired_fingerprint"; then
        die "$ADAPTER adapter failed to install the changed certificate"
    fi

    verified=0
    attempt=1
    while [ "$attempt" -le "$VERIFY_ATTEMPTS" ]; do
        [ "$VERIFY_INTERVAL_SECONDS" -eq 0 ] || sleep "$VERIFY_INTERVAL_SECONDS"
        if adapter_fetch_served "$served_cert" \
            && [ "$(certificate_fingerprint "$served_cert")" = "$desired_fingerprint" ] \
            && strict_probe >/dev/null 2>&1; then
            verified=1
            break
        fi
        attempt=$((attempt + 1))
    done

    if [ "$verified" -ne 1 ]; then
        log "new certificate verification failed; attempting adapter rollback"
        adapter_rollback "$served_fingerprint" || log "ERROR: adapter rollback failed"
        die "certificate rotation failed and rollback was attempted"
    fi

    now=$(date -u '+%s')
    write_state 1 "$now" "$not_after_epoch" "$desired_fingerprint" \
        "$desired_spki_pin" "$resource_version"
    log "certificate rotated and verified; fingerprint=$desired_fingerprint not_after=$not_after_text"
)

run_targets() {
    requested=$1
    action=$2
    trust_current=${3:-0}
    failures=0
    count=0
    if [ -n "$requested" ]; then
        sync_target "$requested" "$action" "$trust_current" || failures=1
        count=1
    else
        for target in $(target_names); do
            sync_target "$target" "$action" "$trust_current" || failures=1
            count=$((count + 1))
        done
    fi
    if [ "$count" -eq 0 ]; then
        printf '%s: no targets are configured in %s\n' "$program" "$TARGET_CONFIG_DIR" >&2
        return 1
    fi
    return "$failures"
}

if [ "$#" -eq 0 ]; then
    set -- --all
fi

case "$1" in
    -h|--help) usage ;;
    --metrics) emit_metrics ;;
    --all)
        [ "$#" -eq 1 ] || { usage >&2; exit 2; }
        run_targets '' sync 0
        ;;
    --target)
        [ "$#" -eq 2 ] || { usage >&2; exit 2; }
        run_targets "$2" sync 0
        ;;
    --check-config)
        [ "$#" -le 2 ] || { usage >&2; exit 2; }
        run_targets "${2:-}" check 0
        ;;
    --trust-current-certificate)
        [ "$#" -eq 2 ] || { usage >&2; exit 2; }
        run_targets "$2" sync 1
        ;;
    *) usage >&2; exit 2 ;;
esac
