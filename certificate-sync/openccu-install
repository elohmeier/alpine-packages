#!/bin/sh

# Forced-command handler installed persistently on OpenCCU. It accepts only an
# install or rollback request from the pinned RPi key, validates locally, swaps
# server.pem atomically, reloads lighttpd, and restores the previous PEM if the
# new certificate is not actually served.

set -u
set -f

config_file=${OPENCCU_CERTIFICATE_SYNC_CONFIG:-/usr/local/etc/certificate-sync/config}
[ -r "$config_file" ] || exit 1
# shellcheck disable=SC1090
. "$config_file"

: "${CERTIFICATE_HOSTNAME:=}"
: "${CERTIFICATE_FILE:=/etc/config/server.pem}"
: "${LIGHTTPD_INIT:=/etc/init.d/S50lighttpd}"
: "${MINIMUM_VALID_DAYS:=21}"
: "${VERIFY_ATTEMPTS:=12}"
: "${VERIFY_INTERVAL_SECONDS:=1}"

log() {
    logger -t certificate-sync -- "$*" 2>/dev/null || true
    printf '%s\n' "$*" >&2
}

fingerprint() {
    openssl x509 -in "$1" -noout -fingerprint -sha256 2>/dev/null \
        | sed 's/^[^=]*=//;s/://g' | tr '[:lower:]' '[:upper:]'
}

valid_fingerprint() {
    [ "${#1}" -eq 64 ] || return 1
    case "$1" in *[!0-9A-F]*) return 1 ;; esac
}

reload_lighttpd() {
    "$LIGHTTPD_INIT" reload >/dev/null 2>&1
}

served_fingerprint() {
    raw=$work_dir/served.raw
    cert=$work_dir/served.crt
    : >"$raw"
    timeout 10 openssl s_client -connect 127.0.0.1:443 \
        -servername "$CERTIFICATE_HOSTNAME" </dev/null >"$raw" 2>/dev/null || true
    awk '
        /-----BEGIN CERTIFICATE-----/ { capture=1 }
        capture { print }
        /-----END CERTIFICATE-----/ { exit }
    ' "$raw" >"$cert"
    fingerprint "$cert"
}

verify_served() {
    expected=$1
    attempt=1
    while [ "$attempt" -le "$VERIFY_ATTEMPTS" ]; do
        [ "$VERIFY_INTERVAL_SECONDS" -eq 0 ] || sleep "$VERIFY_INTERVAL_SECONDS"
        [ "$(served_fingerprint)" = "$expected" ] && return 0
        attempt=$((attempt + 1))
    done
    return 1
}

validate_pem() {
    pem=$1
    expected=$2
    cert_public=$work_dir/cert-public.der
    key_public=$work_dir/key-public.der
    openssl x509 -in "$pem" -noout -checkhost "$CERTIFICATE_HOSTNAME" \
        >/dev/null 2>&1 || return 1
    openssl x509 -in "$pem" -noout -checkend "$((MINIMUM_VALID_DAYS * 86400))" \
        >/dev/null 2>&1 || return 1
    [ "$(fingerprint "$pem")" = "$expected" ] || return 1
    openssl x509 -in "$pem" -pubkey -noout 2>/dev/null \
        | openssl pkey -pubin -outform DER >"$cert_public" 2>/dev/null || return 1
    openssl pkey -in "$pem" -pubout -outform DER >"$key_public" 2>/dev/null \
        || return 1
    cmp -s "$cert_public" "$key_public"
}

# Intentional word splitting parses the two-word forced-command protocol; glob
# expansion is disabled above and both words are validated before use.
# shellcheck disable=SC2086
set -- ${SSH_ORIGINAL_COMMAND:-}
[ "$#" -eq 2 ] || exit 1
operation=$1
expected_fingerprint=$2
valid_fingerprint "$expected_fingerprint" || exit 1
[ -n "$CERTIFICATE_HOSTNAME" ] || exit 1

certificate_dir=${CERTIFICATE_FILE%/*}
backup_file=$CERTIFICATE_FILE.certificate-sync-backup
work_dir=$(mktemp -d "$certificate_dir/.certificate-sync.XXXXXX") || exit 1
incoming=$work_dir/server.pem
replacement=$work_dir/replacement.pem
cleanup() {
    rm -rf -- "$work_dir"
    rm -f -- "$backup_file.new"
}
trap cleanup EXIT HUP INT TERM
umask 077

case "$operation" in
    install)
        cat >"$incoming"
        validate_pem "$incoming" "$expected_fingerprint" || {
            log "rejected invalid certificate input"
            exit 1
        }
        [ -s "$CERTIFICATE_FILE" ] || exit 1
        cp -p "$CERTIFICATE_FILE" "$backup_file.new" || exit 1
        mv -f "$backup_file.new" "$backup_file" || exit 1
        chmod 600 "$incoming"
        mv -f "$incoming" "$CERTIFICATE_FILE" || exit 1
        if reload_lighttpd && verify_served "$expected_fingerprint"; then
            log "installed and verified certificate fingerprint=$expected_fingerprint"
            exit 0
        fi
        log "certificate verification failed; restoring previous PEM"
        cp -p "$backup_file" "$replacement" || exit 1
        mv -f "$replacement" "$CERTIFICATE_FILE" || exit 1
        reload_lighttpd || true
        exit 1
        ;;
    rollback)
        [ -s "$backup_file" ] || exit 1
        [ "$(fingerprint "$backup_file")" = "$expected_fingerprint" ] || exit 1
        cp -p "$backup_file" "$replacement" || exit 1
        mv -f "$replacement" "$CERTIFICATE_FILE" || exit 1
        reload_lighttpd || exit 1
        verify_served "$expected_fingerprint"
        ;;
    *) exit 1 ;;
esac
